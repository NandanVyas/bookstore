{
  "name": "nv-bookstore",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "description": "A modern full-stack bookstore built with Next.js, TypeScript, and MongoDB.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:seed": "tsx scripts/seed.ts",
    "admin:promote": "tsx scripts/promote-admin.ts"
  },
  "dependencies": {
    "argon2": "0.44.0",
    "jose": "^6.1.0",
    "lucide-react": "^1.31.0",
    "mongoose": "^9.1.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
